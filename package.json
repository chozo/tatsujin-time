{
  "name": "tatsujin-time",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "rm -rf dist && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "ogp": "node tools/make-ogp.mjs",
    "promo": "npm run build && node tools/promo/make-bgm.mjs && node tools/promo/record.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "1.49",
    "typescript": "5.6",
    "vite": "^6.4.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.151.3"
  }
}
